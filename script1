#!/bin/bash

# Configuración
DISK="/dev/sdb"
VG_NAME="irisvg"
LV1_NAME="iris"
LV1_SIZE="50G"
LV2_NAME="store"
LV2_SIZE="40G"
MOUNT_POINT1="/trak/clov/uat/iris"
MOUNT_POINT2="/trak/clov/uat/store"

# Verifica si se ejecuta como root
if [[ $EUID -ne 0 ]]; then
  echo "Este script debe ejecutarse como root." >&2
  exit 1
fi

echo "Preparando el disco $DISK para LVM..."

# Crear una partición para LVM
echo "Creando partición LVM..."
parted -s $DISK mkpart primary 0% 100%
parted -s $DISK set 1 lvm on

# Crear un volumen físico
echo "Inicializando volumen físico..."
PV="${DISK}1"
pvcreate $PV

# Crear el grupo de volúmenes
echo "Creando grupo de volúmenes $VG_NAME..."
vgcreate $VG_NAME $PV

# Crear los volúmenes lógicos
echo "Creando volúmenes lógicos..."
lvcreate -L $LV1_SIZE -n $LV1_NAME $VG_NAME
lvcreate -L $LV2_SIZE -n $LV2_NAME $VG_NAME

# Formatear los volúmenes lógicos
echo "Formateando los volúmenes lógicos..."
mkfs.xfs /dev/$VG_NAME/$LV1_NAME
mkfs.xfs /dev/$VG_NAME/$LV2_NAME

# Crear puntos de montaje
echo "Creando puntos de montaje..."
mkdir -p $MOUNT_POINT1 $MOUNT_POINT2

# Montar los volúmenes lógicos
echo "Montando los volúmenes lógicos..."
mount /dev/$VG_NAME/$LV1_NAME $MOUNT_POINT1
mount /dev/$VG_NAME/$LV2_NAME $MOUNT_POINT2

# Agregar a fstab para montajes persistentes
echo "Agregando los volúmenes a /etc/fstab..."
echo "/dev/$VG_NAME/$LV1_NAME  $MOUNT_POINT1  xfs  defaults  0 0" >> /etc/fstab
echo "/dev/$VG_NAME/$LV2_NAME  $MOUNT_POINT2  xfs  defaults  0 0" >> /etc/fstab

# Verificar montaje
echo "Verificando puntos de montaje..."
df -h | grep $VG_NAME

echo "Proceso completado. Los volúmenes están listos."
